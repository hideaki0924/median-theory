<button class="go" onclick="analyzeCurrent()">占有率を解析</button><button class="save" onclick="saveSnapshot()">事前データを保存</button><button class="sample" onclick="fillSample()">サンプル</button><button class="clear" onclick="clearCurrent()">入力をクリア</button>
<div class="mini">主比較：2車複T10・ワイドT10・三連複T20。2車複/ワイドT20も補助保存します。</div></div>
<div id="analysisOut"></div>

<div class="card good"><h2>③ 結果を追記</h2><div class="grid three">
<div><label>保存済みレース</label><select id="resultRecord" onchange="showSelectedRecord()"></select></div><div><label>1着</label><input id="result1" type="number" min="1" max="8"></div><div><label>2着</label><input id="result2" type="number" min="1" max="8"></div>
<div><label>3着</label><input id="result3" type="number" min="1" max="8"></div><div><label>三連複配当（円）</label><input id="payout" type="number" min="0"></div><div><label>結果メモ</label><input id="resultNote" placeholder="前残り、落車など"></div>
</div><button class="result" onclick="updateResult()">結果を保存・更新</button><div id="selectedRecordInfo" class="mini"></div></div>

<div class="card"><h2>④ 保存・集計</h2>
<button class="export" onclick="exportCsv()">CSV出力</button><label class="fileLabel">CSV読込<input type="file" accept=".csv,text/csv" onchange="importCsv(event)"></label><button class="export" onclick="exportJson()">完全バックアップJSON</button><label class="fileLabel">JSON復元<input type="file" accept=".json" onchange="importJson(event)"></label><button class="delete" onclick="deleteAll()">全データ削除</button>
